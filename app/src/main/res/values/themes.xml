<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.BlogSphere" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorPrimaryVariant">@color/purple_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/pink_accent</item>
        <item name="colorSecondaryVariant">@color/pink_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/surface_light</item>
        <item name="colorOnSurface">@color/on_surface_light</item>
        <item name="android:statusBarColor">@color/purple_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="materialButtonStyle">@style/PrimaryButtonStyle</item>
    </style>

    <style name="Theme.BlogSphere.Splash" parent="Theme.BlogSphere">
        <item name="android:statusBarColor">@color/purple_primary</item>
        <item name="android:windowBackground">@color/purple_primary</item>
    </style>

    <!-- ============================================================ -->
    <!-- Component styles                                              -->
    <!-- ============================================================ -->

    <style name="BlogCardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">1dp</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="rippleColor">@color/purple_light</item>
        <item name="android:layout_marginHorizontal">14dp</item>
        <item name="android:layout_marginVertical">7dp</item>
        <item name="contentPadding">0dp</item>
    </style>

    <style name="PrimaryButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="OutlinedButtonStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="strokeColor">?attr/colorPrimary</item>
    </style>

    <style name="TextButtonStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ============================================================ -->
    <!-- Typography scale                                              -->
    <!-- ============================================================ -->

    <style name="Text.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Text.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="Text.SectionHeader" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
    </style>

    <style name="Text.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/on_surface_variant_light</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Text.Label" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/on_surface_variant_light</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Backwards-compat aliases used by existing layouts -->
    <style name="TitleHeading" parent="Text.Title" />
    <style name="SubtitleText" parent="Text.Body" />
    <style name="MutedText" parent="Text.Caption" />
</resources>
